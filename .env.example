OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PDF_PREPROCESS_ENABLED=true
PDF_DOWNLOAD_TIMEOUT_SECONDS=10
PDF_MAX_BYTES=10485760
PDF_MAX_FILES=8
PDF_EXTRACTED_TEXT_MAX_CHARS=60000
